{
  "name": "@sria/cap",
  "version": "0.1.0",
  "description": "SAP CAP Node.js Backend Service for Sria Info Tech AI Finance",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cds watch",
    "start": "cds-serve",
    "build": "cds build --no-ws-pack",
    "deploy": "cds deploy --to sqlite:sqlite.db",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/**/*.test.*"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3.1.3",
    "@sap/cds": "^10.2.2",
    "@sria/contracts": "*",
    "decimal.js": "^10.6.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@sap/cds-dk": "^10.2.1",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
