# ========================================================
# Sria Info Tech AI Finance Dashboard Generator
# Environment Configuration Template
# ========================================================
# Copy this file to .env before starting the development environment.
# Never commit real credentials or keys to Git.

# --- General Application ---
PORT=4004
NODE_ENV=development

# --- SAP BTP & CAP ---
# Local profile uses SQLite; production profile uses SAP HANA Cloud
CDS_ENV=development

# --- Environment tier (validated at startup; reported by /health) ---
# Values: mock | local | pilot | production
# NODE_ENV=production requires pilot or production; production forbids mock providers.
APP_ENV_TIER=local

# --- CORS ---
# Comma-separated explicit origins. Never "*". Defaults to the Vite dev server for mock/local.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- S/4HANA Finance Data Provider ---
# Values: mock | s4hana
FINANCE_DATA_PROVIDER=mock
# S/4HANA Destination Name configured in BTP (required when FINANCE_DATA_PROVIDER=s4hana)
FINANCE_S4HANA_DESTINATION_NAME=S4HANA_FINANCE_API

# --- S/4HANA adapter settings (G2-03). ALL ARE CANDIDATES until confirmed against the real system's $metadata ---
# Service path and entity set of the journal-entry-item API
# S4_SERVICE_ROOT=/sap/opu/odata/sap/API_JOURNALENTRYITEMBASIC_SRV
# S4_ENTITY_SET=A_JournalEntryItemBasic
# Ledger to read (leading ledger is usually 0L); reading several ledgers would double count
# S4_LEDGER=0L
# INDICATOR = amounts are absolute and the S/H indicator gives the direction; SIGNED_DEBIT_POSITIVE = amounts carry the sign
# S4_AMOUNT_CONVENTION=INDICATOR
# GL account ranges that count as revenue / expenses in the customer's chart of accounts (comma-separated from-to ranges)
# S4_REVENUE_ACCOUNTS=400000-499999
# S4_EXPENSE_ACCOUNTS=500000-699999

# --- Runtime AI Provider (Pending Corporate Approval) ---
# Values: mock | replay | openai | azure-openai | anthropic | gemini-api
# mock    = offline test double (default; no network, no cost)
# replay  = plays back recorded answers from AI_REPLAY_FILE (deterministic tests)
# others  = LIVE providers: refuse to start until AI_PROVIDER_APPROVED=true (see docs/ai/PROVIDER-APPROVAL.md)
AI_RUNTIME_PROVIDER=mock
# AI_RUNTIME_API_KEY and AI_RUNTIME_ENDPOINT are required when the provider is not mock.
# Set them in the BTP credential store or a local .env (never committed).
# AI_RUNTIME_API_KEY=
# AI_RUNTIME_ENDPOINT=
AI_RUNTIME_MODEL=gemini-2.5-flash

# --- G2-04 LLM gateway (all optional; safe defaults) ---
# AI_PROVIDER_APPROVED=false        # set true ONLY after docs/ai/PROVIDER-APPROVAL.md is signed
# AI_REPLAY_FILE=tests/eval/replay/intent-v2.mock.replay.json
# AI_MODEL_GOAL=                    # model for goal understanding (required for a live provider)
# AI_TIMEOUT_MS=15000               # hard per-call timeout
# AI_MAX_RETRIES=2                  # retries only for rate-limit / server errors
# AI_MAX_TOKENS_PER_RUN=20000
# AI_MAX_TOKENS_PER_TENANT_DAY=500000
# AI_PRICE_IN_PER_MTOK=0            # cost estimate only; set from the provider's price list
# AI_PRICE_OUT_PER_MTOK=0
# AGENT_GOAL=on                     # on = structured AgentGoal path; off = legacy intent path
