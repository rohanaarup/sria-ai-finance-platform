# ========================================================
# Sria Info Tech AI Finance Dashboard Generator
# Environment Configuration Template
# ========================================================
# Copy this file to .env before starting the development environment.
# Never commit real credentials or keys to Git.

# --- General Application ---
PORT=4004
NODE_ENV=development

# --- SAP BTP & CAP ---
# Local profile uses SQLite; production profile uses SAP HANA Cloud
CDS_ENV=development

# --- Environment tier (validated at startup; reported by /health) ---
# Values: mock | local | pilot | production
# NODE_ENV=production requires pilot or production; production forbids mock providers.
APP_ENV_TIER=local

# --- CORS ---
# Comma-separated explicit origins. Never "*". Defaults to the Vite dev server for mock/local.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- S/4HANA Finance Data Provider ---
# Values: mock | s4hana
FINANCE_DATA_PROVIDER=mock
# S/4HANA Destination Name configured in BTP (required when FINANCE_DATA_PROVIDER=s4hana)
FINANCE_S4HANA_DESTINATION_NAME=S4HANA_FINANCE_API

# --- Runtime AI Provider (Pending Corporate Approval) ---
# Values: mock | openai | azure-openai | gemini-api
AI_RUNTIME_PROVIDER=mock
# AI_RUNTIME_API_KEY and AI_RUNTIME_ENDPOINT are required when the provider is not mock.
# Set them in the BTP credential store or a local .env (never committed).
# AI_RUNTIME_API_KEY=
# AI_RUNTIME_ENDPOINT=
AI_RUNTIME_MODEL=gemini-2.5-flash

